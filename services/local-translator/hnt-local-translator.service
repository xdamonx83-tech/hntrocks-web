[Unit]
Description=HNT.ROCKS local Argos translation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hunthub
Group=hunthub
WorkingDirectory=/home/users/hunthub/www/hnt.rocks/services/local-translator
Environment=HOME=/home/users/hunthub
Environment=PYTHONUNBUFFERED=1
Environment=ARGOS_DEVICE_TYPE=cpu
Environment=HNT_TRANSLATOR_HOST=127.0.0.1
Environment=HNT_TRANSLATOR_PORT=8787
ExecStart=/home/users/hunthub/www/hnt.rocks/services/local-translator/.venv/bin/python /home/users/hunthub/www/hnt.rocks/services/local-translator/server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
