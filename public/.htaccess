<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP_AUTHORIZATION}]

    # HNT.ROCKS React frontend lives in public/app.
    # Only routes that already exist in the React app are handed to its SPA.
    # Laravel keeps handling API, social callbacks, maps, guides, LFG, teams,
    # moments, legal pages, admin pages and every route not listed here.
    RewriteRule ^$ app/index.html [L]
    RewriteRule ^(?:feed|saved|play|discover|404)/?$ app/index.html [L]
    RewriteRule ^dashboards/default/?$ app/index.html [L]
    RewriteRule ^pages/user/(?:overview|projects|permissions|friends|social)/?$ app/index.html [L]
    RewriteRule ^auth/?$ app/index.html [L]
    RewriteRule ^auth/(?:sign-in|two-factor|sign-up|password-reset|password-sent|password-new|get-verification|set-verification|terms-and-conditions|privacy-policy)/?$ app/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
